---
const { t } = Astro.props;
---
<section id="features" class="dirs">
<div class="wrap">
  <div class="head c"><div class="eyebrow"><i></i>{t.the_whole_platform}</div><h2>{t.find_the_system}<br><em>{t.your_game_needs}</em></h2><p class="sub">{t.the_whole_platform_under_five}</p></div>
  <div class="dg">
    <div><span class="gi"><svg class="l"><use href="#i-user"/></svg></span><h3>{t.player}</h3><div class="gs">{t.sign_in_accounts_and_lasting}</div><ul><li>{t.guest_sign_in}</li><li>{t.email_and_password}</li><li>{t.oauth_and_google_sign_in}</li><li>{t.account_linking_and_deletion}</li><li>{t.sessions}</li><li>{t.characters}</li><li>{t.cloud_save}</li><li>{t.players_panel}</li></ul></div>
    <div><span class="gi"><svg><use href="#pusula"/></svg></span><h3>{t.economy}</h3><div class="gs">{t.items_currencies_and_sales}</div><ul><li>{t.items_and_inventory}</li><li>{t.currencies_and_balance}</li><li>{t.store}</li><li>{t.in_app_purchases}</li><li>{t.rewards}</li></ul></div>
    <div><span class="gi"><svg><use href="#rozet"/></svg></span><h3>{t.social}</h3><div class="gs">{t.services_that_involve_more_than}</div><ul><li>{t.social_features}</li><li>{t.chat}</li><li>{t.contests}</li><li>{t.leaderboards}</li><li>{t.notifications}</li><li>{t.real_time_connection}</li><li>{t.reconnection_and_limits}</li><li>{t.relay_plugin}</li></ul></div>
    <div><span class="gi"><svg><use href="#harita"/></svg></span><h3>{t.content}</h3><div class="gs">{t.the_game_world_and_server}</div><ul><li>{t.scenes}</li><li>{t.assets_and_models}</li><li>{t.content_groups}</li><li>{t.game_rules}</li><li>{t.server_time}</li><li>{t.multi_game_several_games_in}</li></ul></div>
    <div><span class="gi"><svg class="l"><use href="#i-term"/></svg></span><h3>{t.developer_tools}</h3><div class="gs">{t.sdks_extensions_and_operations}</div><ul><li>Unity SDK</li><li>TypeScript SDK</li><li>{t.using_mcp_and_agents_md}</li><li>{t.plugins}</li><li>{t.webhook_events}</li><li>{t.bff_pattern}</li><li>{t.api_keys_and_security}</li><li>{t.rate_limits_and_versioning}</li><li>{t.going_live_and_hosting}</li></ul></div>
  </div>
  <p class="dnote">{t.the_directory_follows_the_topics}</p>
</div>
</section>
