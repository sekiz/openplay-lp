---
// Diğer dillerde yazı sayfaları. Çevirisi olmayan yazı İngilizce gösterilir ve canonical adresi İngilizce sayfadır.
import BlogPost from '../../../components/blog/BlogPost.astro';
import { locales, defaultLocale } from '../../../i18n/index.js';
import { getPosts } from '../../../lib/blog.js';
export async function getStaticPaths() {
  const out = [];
  for (const lang of locales.filter((l) => l !== defaultLocale)) {
    for (const post of await getPosts(lang)) out.push({ params: { lang, slug: post.slug }, props: { post } });
  }
  return out;
}
const { lang } = Astro.params;
const { post } = Astro.props;
---
<BlogPost lang={lang} post={post} />
